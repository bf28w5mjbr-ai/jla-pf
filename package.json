{
  "name": "bluvium",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "prisma generate && next dev",
    "dev:logged": "mkdir -p .logs && next dev 2>&1 | tee .logs/next-dev.log",
    "dev:log:tail": "mkdir -p .logs && touch .logs/next-dev.log && tail -n 100 -f .logs/next-dev.log",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "cap:sync": "cap sync",
    "cap:copy": "cap copy",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest",
    "test:registration": "vitest run src/lib/registration src/lib/otp/verifyChannelOtp.test.ts src/lib/smsHoldPolicy.test.ts",
    "check:registration-otp": "node scripts/check-registration-otp-invariants.mjs",
    "migrate:storage:supabase": "node --env-file=.env.local scripts/migrate-storage-to-supabase.mjs",
    "migrate:storage:supabase:dry": "node --env-file=.env.local scripts/migrate-storage-to-supabase.mjs --dry-run",
    "cleanup:uploads:dry": "node scripts/cleanup-local-uploads.mjs --dry-run",
    "cleanup:uploads": "node scripts/cleanup-local-uploads.mjs",
    "test:push:api": "node scripts/test-manual-push-api.mjs",
    "verify:production": "node scripts/verify-production-endpoints.mjs",
    "verify:pdf-font-nft": "node scripts/verify-pdf-font-nft.mjs",
    "measure:ttfb": "node scripts/measure-ttfb.mjs",
    "copy-db:data:dry": "node --env-file=.env scripts/copy-public-schema-data.mjs --dry-run",
    "copy-db:data": "node --env-file=.env scripts/copy-public-schema-data.mjs --truncate-first",
    "seed:potato-ocean-woman": "node --env-file=.env.local scripts/seed-potato-ocean-woman.mjs",
    "seed:potato-ocean-woman:force": "node --env-file=.env.local scripts/seed-potato-ocean-woman.mjs --force",
    "test:start-list": "vitest run src/lib/startListFunctional.test.ts",
    "test:start-list:integration": "START_LIST_INTEGRATION_TEST=1 vitest run src/lib/startListFunctional.integration.test.ts",
    "test:start-list:db": "node --env-file=.env.local scripts/seed-potato-ocean-woman.mjs && START_LIST_INTEGRATION_TEST=1 vitest run src/lib/startListFunctional.test.ts src/lib/startListFunctional.integration.test.ts",
    "reset:start-list:event": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/reset-start-list-one-event.ts",
    "backfill:event-stored-names": "tsx --tsconfig tsconfig.json --env-file=.env scripts/backfill-event-stored-names.ts",
    "suggest:under-u-from-categories": "tsx --tsconfig tsconfig.json --env-file=.env scripts/suggest-under-u-from-age-categories.ts",
    "formalize:organization": "tsx --tsconfig tsconfig.json --env-file=.env scripts/formalize-organization-by-name.ts",
    "seed:jla-affiliate-clubs": "tsx --tsconfig tsconfig.json --env-file=.env scripts/seed-jla-affiliate-clubs.ts",
    "backfill:to-assignment-from-official-apps": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/backfill-to-assignment-from-official-applications.ts",
    "backfill:to-assignment-from-official-apps:dry": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/backfill-to-assignment-from-official-applications.ts --dry-run",
    "diagnose:club-to-reflection": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/diagnose-club-to-reflection.ts",
    "crosscheck:to-app-vs-assignment": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/crosscheck-to-application-vs-assignment.ts",
    "backfill:entry-club-id-from-snapshot": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/backfill-competition-entry-club-id-from-snapshot.ts",
    "backfill:entry-club-id-from-snapshot:dry": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/backfill-competition-entry-club-id-from-snapshot.ts --dry-run",
    "delete:kanagawa28-entries:dry": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/delete-competition-entries-kanagawa28-two-users.ts --dry-run",
    "delete:kanagawa28-entries": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/delete-competition-entries-kanagawa28-two-users.ts --execute",
    "backfill:team-only-zero-fee:dry": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/backfill-team-only-intent-zero-total-fee.ts --dry-run",
    "backfill:team-only-zero-fee": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/backfill-team-only-intent-zero-total-fee.ts --apply",
    "backfill:team-entry-single-suffix:dry": "tsx --tsconfig tsconfig.json scripts/backfill-team-entry-single-suffix-names.ts --dry-run",
    "backfill:team-entry-single-suffix": "tsx --tsconfig tsconfig.json scripts/backfill-team-entry-single-suffix-names.ts --apply",
    "audit:registration-data": "tsx --tsconfig tsconfig.json --env-file=.env scripts/audit-registration-data-consistency.ts",
    "backfill:profile-normalized-kana:dry": "tsx --tsconfig tsconfig.json --env-file=.env scripts/backfill-user-profile-normalized-kana.ts --dry-run",
    "backfill:profile-normalized-kana": "tsx --tsconfig tsconfig.json --env-file=.env scripts/backfill-user-profile-normalized-kana.ts --apply",
    "backfill:seed-user-hygiene:dry": "tsx --tsconfig tsconfig.json --env-file=.env scripts/backfill-seed-user-hygiene.ts --dry-run",
    "backfill:seed-user-hygiene": "tsx --tsconfig tsconfig.json --env-file=.env scripts/backfill-seed-user-hygiene.ts --apply",
    "cleanup:registration-sessions:dry": "tsx --tsconfig tsconfig.json --env-file=.env scripts/cleanup-expired-registration-sessions.ts --dry-run",
    "cleanup:registration-sessions": "tsx --tsconfig tsconfig.json --env-file=.env scripts/cleanup-expired-registration-sessions.ts --apply",
    "report:duplicate-person-profiles": "tsx --tsconfig tsconfig.json --env-file=.env scripts/report-duplicate-person-profiles.ts",
    "compare:user-footprint": "tsx --tsconfig tsconfig.json --env-file=.env scripts/compare-user-data-footprint.ts",
    "merge:duplicate-users:dry": "tsx --tsconfig tsconfig.json --env-file=.env scripts/merge-duplicate-users.ts --dry-run",
    "merge:duplicate-users": "tsx --tsconfig tsconfig.json --env-file=.env scripts/merge-duplicate-users.ts --apply"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1024.0",
    "@aws-sdk/client-sns": "^3.1024.0",
    "@aws-sdk/s3-request-presigner": "^3.1024.0",
    "@capacitor/android": "^8.2.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/ios": "^8.2.0",
    "@capacitor/push-notifications": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@capgo/capacitor-nfc": "^8.0.22",
    "@fontsource/noto-sans-jp": "5.2.5",
    "@prisma/client": "6.19.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@react-pdf/renderer": "^4.3.2",
    "@simplewebauthn/browser": "^10.0.0",
    "@simplewebauthn/server": "^10.0.1",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.3",
    "@vercel/speed-insights": "^2.0.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "file-type": "21.3.1",
    "firebase-admin": "^13.7.0",
    "jose": "^6.1.3",
    "js-yaml": "^4.1.1",
    "libphonenumber-js": "^1.13.2",
    "lucide-react": "^0.469.0",
    "nanoid": "^5.1.6",
    "next": "16.2.2",
    "qs": "^6.14.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "stripe": "^17.5.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "overrides": {
      "handlebars": "^4.7.9",
      "fast-xml-parser": "^5.5.8",
      "rollup": "^4.59.0"
    },
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.3",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.10.14",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.2",
    "happy-dom": "^20.8.9",
    "pg": "^8.20.0",
    "prisma": "6.19.2",
    "semantic-release": "^24.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "undici": "^6.21.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
