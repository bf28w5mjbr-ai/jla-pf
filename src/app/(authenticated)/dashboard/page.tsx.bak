import { Metadata } from 'next';
import { cookies } from "next/headers";
import { redirect } from "next/navigation";
import { verifySession } from "@/lib/auth";
import { prisma } from "@/server/db";
import AccountDangerZone from '@/components/AccountDangerZone';
import Sidebar from '@/components/Sidebar';

export const metadata: Metadata = {
  title: 'ダッシュボード | JLA PF',
};

export const dynamic = "force-dynamic";

export default async function DashboardPage() {
  const cookieStore = await cookies();
  const token = cookieStore.get("session")?.value;
  const sess = token ? await verifySession(token) : null;
  if (!sess?.userId) redirect("/login");

  const userId = sess.userId;

  // Fetch user data with all necessary information
  const user = await prisma.user.findUnique({
    where: { id: userId },
    select: {
      id: true,
      email: true,
      passwordHash: true,
      familyName: true,
      givenName: true,
      familyNameKana: true,
      givenNameKana: true,
      phoneNumber: true,
      role: true,
      dateOfBirth: true,
      sex: true,
      postalCode: true,
      prefecture: true,
      city: true,
      addressLine1: true,
      addressLine2: true,
      jlaMemberNumber: true,
      createdAt: true,
      memberships: {
        include: {
          club: true
        },
        orderBy: { createdAt: "desc" }
      },
      qualifications: {
        orderBy: { createdAt: "desc" }
      }
    }
  });

  if (!user) redirect("/login");

  return (
    <div className="flex min-h-screen bg-gradient-to-br from-gray-50 via-white to-gray-50 dark:from-gray-950 dark:via-black dark:to-gray-950">
      <Sidebar />
      
      <main className="flex-1 p-6 lg:p-12">
        <div className="max-w-7xl mx-auto">
          {/* ヘッダー */}
          <div className="mb-16">
            <div className="inline-block mb-4">
              <div className="px-4 py-1.5 rounded-full bg-gradient-to-r from-blue-500/10 to-purple-500/10 dark:from-blue-500/20 dark:to-purple-500/20 border border-blue-200/50 dark:border-blue-800/50">
                <span className="text-xs font-bold bg-gradient-to-r from-blue-600 to-purple-600 dark:from-blue-400 dark:to-purple-400 bg-clip-text text-transparent">
                  DASHBOARD
                </span>
              </div>
            </div>
            <h1 className="text-5xl lg:text-6xl font-black text-gray-900 dark:text-white mb-4 tracking-tight">
              {user.familyName} {user.givenName}
            </h1>
            <p className="text-gray-500 dark:text-gray-400 font-medium flex items-center gap-2">
              <span className="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
              {new Date().toLocaleDateString('ja-JP', { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric',
                weekday: 'long'
              })}
            </p>
          </div>

          {/* サマリーカード */}
          <div className="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
            {/* クラブ数 */}
            <div className="group relative bg-white/80 dark:bg-gray-900/50 backdrop-blur-xl rounded-3xl p-8 shadow-lg hover:shadow-2xl transition-all duration-500 border border-gray-200/50 dark:border-gray-800/50 hover:border-blue-500/50 dark:hover:border-blue-500/50 overflow-hidden">
              <div className="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <div className="relative">
                <div className="flex items-center justify-between mb-8">
                  <div className="text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest">Clubs</div>
                  <div className="w-10 h-10 rounded-2xl bg-gradient-to-br from-blue-500/10 to-blue-600/10 dark:from-blue-500/20 dark:to-blue-600/20 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <span className="text-xl">👥</span>
                  </div>
                </div>
                <div className="text-6xl font-black text-gray-900 dark:text-white mb-3 tabular-nums">{user.memberships.length}</div>
                <div className="text-sm font-semibold text-gray-500 dark:text-gray-400">所属クラブ</div>
              </div>
            </div>

            {/* 資格数 */}
            <div className="group relative bg-white/80 dark:bg-gray-900/50 backdrop-blur-xl rounded-3xl p-8 shadow-lg hover:shadow-2xl transition-all duration-500 border border-gray-200/50 dark:border-gray-800/50 hover:border-purple-500/50 dark:hover:border-purple-500/50 overflow-hidden">
              <div className="absolute inset-0 bg-gradient-to-br from-purple-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <div className="relative">
                <div className="flex items-center justify-between mb-8">
                  <div className="text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest">Qualifications</div>
                  <div className="w-10 h-10 rounded-2xl bg-gradient-to-br from-purple-500/10 to-purple-600/10 dark:from-purple-500/20 dark:to-purple-600/20 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <span className="text-xl">📜</span>
                  </div>
                </div>
                <div className="text-6xl font-black text-gray-900 dark:text-white mb-3 tabular-nums">{user.qualifications.length}</div>
                <div className="text-sm font-semibold text-gray-500 dark:text-gray-400">保有資格</div>
              </div>
            </div>

            {/* アカウント経過日数 */}
            <div className="group relative bg-white/80 dark:bg-gray-900/50 backdrop-blur-xl rounded-3xl p-8 shadow-lg hover:shadow-2xl transition-all duration-500 border border-gray-200/50 dark:border-gray-800/50 hover:border-green-500/50 dark:hover:border-green-500/50 overflow-hidden">
              <div className="absolute ins/80 dark:bg-gray-900/50 backdrop-blur-xl rounded-3xl overflow-hidden shadow-lg border border-gray-200/50 dark:border-gray-800/50">
                <div className="px-8 py-6 border-b border-gray-200/50 dark:border-gray-800/50 bg-gradient-to-r from-gray-50/50 to-transparent dark:from-gray-800/30 dark:to-transparent">
                  <h2 className="text-2xl font-black text-gray-900 dark:text-white flex items-center gap-3">
                    <div className="w-10 h-10 rounded-2xl bg-gradient-to-br from-blue-500/10 to-blue-600/10 dark:from-blue-500/20 dark:to-blue-600/20 flex items-center justify-center">
                      <span className="text-xl">👥</span>
                    </div>
                    <span className="tracking-tight">クラブient-to-br from-green-500/10 to-green-600/10 dark:from-green-500/20 dark:to-green-600/20 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <span className="text-xl">📅</span>
                  </div>
                </div>
                <div className="text-6xl font-black text-gray-900 dark:text-white mb-3 tabular-nums">
                  {Math.floor((Date.now() - new Date(user.createdAt).getTime()) / (1000 * 60 * 60 * 24))}
                </div>
                <div className="text-sm font-semibold text-gray-500 dark:text-gray-400">日間利用</div>
              </div>
            </div>
          </div>

          <div className="grid grid-cols-1 xl:grid-cols-3 gap-8">
            {/* 左側: メインコンテンツ */}
            <div className="xl:col-span-2 space-y-8">
              {/* クラブメンバーシップ */}
              <section className="bg-white dark:bg-gray-950 rounded-2xl border-2 border-gray-200 dark:border-gray-800 overflow-hidden hover:border-gray-300 dark:hover:border-gray-700 transition-all duration-300">
                <div className="px-8 py-6 border-b-2 border-gray-200 dark:border-gray-800">
                  <h2 className="text-xl font-bold text-black dark:text-white flex items-center gap-3">
                    <span className="text-2xl">👥</span>
                    <span className="tracking-tight">クラブメンバーシップ</span>
                  </h2>
                </div>
                <div className="overflow-x-auto">
                  <table className="min-w-ful border-gray-200/50 dark:border-gray-800/50">
                        <th className="px-8 py-4 text-left text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest">Name</th>
                        <th className="px-8 py-4 text-left text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest">Role</th>
                        <th className="px-8 py-4 text-left text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest">Status</th>
                        <th className="px-8 py-4 text-left text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest">Joined</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-gray-200/30 dark:divide-gray-800/30">
                      {user.memberships.map(m => (
                        <tr key={m.id} className="group hover:bg-gray-50/50 dark:hover:bg-gray-800/30 transition-all duration-200">
                          <td className="px-8 py-5">
                            <div className="flex items-center gap-4">
                              <div className="relative w-11 h-11 rounded-2xl bg-gradient-to-br from-blue-500/10 to-purple-500/10 dark:from-blue-500/20 dark:to-purple-500/20 flex items-center justify-center font-black text-gray-900 dark:text-white border border-gray-200/50 dark:border-gray-700/50 group-hover:border-blue-500/50 dark:group-hover:border-blue-400/50 transition-all duration-300 group-hover:scale-110">
                                {m.club.name.charAt(0)}
                              </div>
                              <span className="font-bold text-gray-900 dark:text-white">{m.club.name}</span>
                            </div>
                          </td>
                          <td className="px-8 py-5">
                            <span className="inline-flex items-center px-3 py-1.5 rounded-xl text-xs font-bold bg-gray-100/80 dark:bg-gray-800/80 text-gray-700 dark:text-gray-300 border border-gray-200/50 dark:border-gray-700/50">
                              {m.role}
                            </span>
                          </td>
                          <td className="px-8 py-5">
                            <div className="flex items-center gap-2">
                              <span className="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                              <span className="text-sm font-bold text-gray-900 dark:text-white">{m.status}</span>
                            </div>
                          </td>
                          <td className="px-8 py-5 text-sm font-semibold text-gray-500 dark:text-gray-400 tabular-nums">
                            {new Date(m.createdAt).toLocaleDateString('ja-JP', { year: 'numeric', month: 'short', day: 'numeric' })}
                          </td>
                        </tr>
                      ))}
                      {user.memberships.length === 0 && (
                        <tr>
                          <td className="px-8 py-20 text-center text-gray-400 dark:text-gray-600" colSpan={4}>
                            <div className="flex flex-col items-center gap-4">
                              <div className="w-16 h-16 rounded-3xl bg-gray-100/50 dark:bg-gray-800/50 flex items-center justify-center">
                                <span className="text-3xl opacity-40">👥</span>
                              </div>
                              <p className="text-sm font-semibold-center gap-4">
                              <span className="text-5xl opacity-30">👥</span>
                              <p className="text-sm font-medium">クラブメンバーシップがありません</p>
                            </div>
                          </td>
                        </tr>
                      )}
                    </tbody>
                  </table>/80 dark:bg-gray-900/50 backdrop-blur-xl rounded-3xl overflow-hidden shadow-lg border border-gray-200/50 dark:border-gray-800/50">
                <div className="px-8 py-6 border-b border-gray-200/50 dark:border-gray-800/50 bg-gradient-to-r from-gray-50/50 to-transparent dark:from-gray-800/30 dark:to-transparent">
                  <h2 className="text-2xl font-black text-gray-900 dark:text-white flex items-center gap-3">
                    <div className="w-10 h-10 rounded-2xl bg-gradient-to-br from-purple-500/10 to-purple-600/10 dark:from-purple-500/20 dark:to-purple-600/20 flex items-center justify-center">
                      <span className="text-xl">📜</span>
                    </div>
                    <span className="tracking-tight">資格</span>
                  </h2>
                </div>
                <div className="overflow-x-auto">
                  <table className="min-w-full">
                    <thead>
                      <tr className="border-b border-gray-200/50 dark:border-gray-800/50">
                        <th className="px-8 py-4 text-left text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest">Type</th>
                        <th className="px-8 py-4 text-left text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest">Cert No.</th>
                        <th className="px-8 py-4 text-left text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest">Status</th>
                        <th className="px-8 py-4 text-left text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest">Expires</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-gray-200/30 dark:divide-gray-800/30">
                      {user.qualifications.map(q => (
                        <tr key={q.id} className="group hover:bg-gray-50/50 dark:hover:bg-gray-800/30 transition-all duration-200">
                          <td className="px-8 py-5">
                            <div className="flex items-center gap-4">
                              <div className="relative w-11 h-11 rounded-2xl bg-gradient-to-br from-purple-500/10 to-pink-500/10 dark:from-purple-500/20 dark:to-pink-500/20 flex items-center justify-center border border-gray-200/50 dark:border-gray-700/50 group-hover:border-purple-500/50 dark:group-hover:border-purple-400/50 transition-all duration-300 group-hover:scale-110">
                                <span className="text-xl">📜</span>
                              </div>
                              <span className="font-bold text-gray-900 dark:text-white">{q.kind}</span>
                            </div>
                          </td>
                          <td className="px-8 py-5 text-sm font-mono font-semibold text-gray-500 dark:text-gray-400 tabular-nums">{q.certNumber ?? "-"}</td>
                          <td className="px-8 py-5">
                            {q.status === 'ACTIVE' ? (
                              <div className="flex items-center gap-2">
                                <span className="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                                <span className="text-sm font-bold text-gray-900 dark:text-white">ACTIVE</span>
                              </div>
                            ) : (
                              <div className="flex items-center gap-2">
                                <span className="w-2 h-2 rounded-full bg-red-500"></span>
                                <span className="text-sm font-bold text-gray-500 dark:text-gray-400 line-through">EXPIRED</span>
                              </div>
                            )}
                          </td>
                          <td className="px-8 py-5 text-sm font-semibold text-gray-500 dark:text-gray-400 tabular-nums">
                            {q.expiryDate ? new Date(q.expiryDate).toLocaleDateString('ja-JP', { year: 'numeric', month: 'short', day: 'numeric' }) : "-"}
                          </td>
                        </tr>
                      ))}
                      {user.qualifications.length === 0 && (
                        <tr>
                          <td className="px-8 py-20 text-center text-gray-400 dark:text-gray-600" colSpan={4}>
                            <div className="flex flex-col items-center gap-4">
                              <div className="w-16 h-16 rounded-3xl bg-gray-100/50 dark:bg-gray-800/50 flex items-center justify-center">
                                <span className="text-3xl opacity-40">📜</span>
                              </div>
                              <p className="text-sm font-semibold
                        <tr>
                          <td className="px-8 py-16 text-center text-gray-400 dark:text-gray-600" colSpan={4}>
                            <div className="flex flex-col items-center gap-4">
                              <span className="text-5xl opacity-30">📜</span>
                              <p className="text-sm font-medium">資格情報がありません</p>
                            </div>sticky top-8 bg-white/80 dark:bg-gray-900/50 backdrop-blur-xl rounded-3xl overflow-hidden shadow-lg border border-gray-200/50 dark:border-gray-800/50">
                <div className="px-8 py-6 border-b border-gray-200/50 dark:border-gray-800/50 bg-gradient-to-r from-gray-50/50 to-transparent dark:from-gray-800/30 dark:to-transparent">
                  <h2 className="text-2xl font-black text-gray-900 dark:text-white flex items-center gap-3">
                    <div className="w-10 h-10 rounded-2xl bg-gradient-to-br from-gray-500/10 to-gray-600/10 dark:from-gray-500/20 dark:to-gray-600/20 flex items-center justify-center">
                      <span className="text-xl">👤</span>
                    </div>
                    <span className="tracking-tight">アカウント</span>
                  </h2>
                </div>
                <div className="p-8 space-y-6">
                  <div className="text-center pb-6 border-b border-gray-200/50 dark:border-gray-800/50">
                    <div className="relative w-24 h-24 mx-auto mb-5">
                      <div className="absolute inset-0 bg-gradient-to-br from-blue-500/20 to-purple-500/20 rounded-3xl blur-xl"></div>
                      <div className="relative w-24 h-24 rounded-3xl bg-gradient-to-br from-blue-500/10 to-purple-500/10 dark:from-blue-500/20 dark:to-purple-500/20 flex items-center justify-center text-gray-900 dark:text-white text-3xl font-black border border-gray-200/50 dark:border-gray-700/50">
                        {user.familyName.charAt(0)}{user.givenName.charAt(0)}
                      </div>
                    </div>
                    <h3 className="text-xl font-black text-gray-900 dark:text-white mb-2">
                      {user.familyName} {user.givenName}
                    </h3>
                    <p className="text-sm font-semibold text-gray-500 dark:text-gray-400">{user.email}</p>
                  </div>
                  
                  <div>
                    <a
                      href="/settings"
                      className="group relative flex items-center justify-center gap-3 w-full px-6 py-4 rounded-2xl bg-gradient-to-r from-gray-900 to-gray-800 dark:from-white dark:to-gray-100 text-white dark:text-black font-bold hover:shadow-xl transition-all duration-300 overflow-hidden"
