model ExpenseAttachment {
  id           String   @id @default(cuid())
  expenseId    String
  url          String
  filename     String?
  mimeType     String?
  size         Int?
  uploadedById String
  createdAt    DateTime @default(now())

  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("ExpenseAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([expenseId])
}

model Budget {
  id         String           @id @default(cuid())
  ownerType  ExpenseOwnerType
  ownerId    String
  fiscalYear Int
  limit      Int
  used       Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([ownerType, ownerId, fiscalYear])
}

model Payment {
  id                      String           @id @default(cuid())
  type                    PaymentType
  ownerType               PaymentOwnerType
  ownerId                 String
  userId                  String
  status                  PaymentStatus    @default(PENDING)
  amount                  Int
  currency                String           @default("jpy")
  stripeCheckoutSessionId String?          @unique
  stripePaymentIntentId   String?
  /// 進行中の Stripe Dispute ID（charge.dispute.created で設定）
  stripeDisputeId         String?
  metadata                Json?
  paidAt                  DateTime?
  expiresAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerType, ownerId, type])
  @@index([status])
  @@index([userId])
}

model StripeEvent {
  id           String            @id @default(cuid())
  eventId      String            @unique
  type         String
  accountId    String?
  livemode     Boolean
  data         Json
  status       StripeEventStatus @default(RECEIVED)
  errorMessage String?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([type])
  @@index([status])
}

model EntryCheckoutSession {
  id                      String                     @id @default(cuid())
  competitionId           String
  clubId                  String
  userId                  String
  status                  EntryCheckoutSessionStatus @default(PENDING)
  amount                  Int
  currency                String                     @default("jpy")
  stripeCheckoutSessionId String?                    @unique
  /// Checkout 完了後の PaymentIntent ID（紛争 Webhook の突合に使用）
  stripePaymentIntentId   String?
  /// 進行中の紛争（charge.dispute.created で設定、closed でクリア）
  stripeDisputeId         String?
  /// Stripe Charge.receipt_url（カード決済のホスト領収書）
  stripeReceiptUrl        String?
  payload                 Json?
  completedAt             DateTime?
  expiredAt               DateTime?
  entryId                 String?

  competition Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  club        Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry       CompetitionEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competitionId, userId])
  @@index([stripePaymentIntentId])
}

/// クラブが大会で特定メンバーの個人参加費を肩代わりする枠（先払い or 締切後請求）
enum ClubPrepaidIndividualSlotStatus {
  /// チーム請求の Checkout 完了待ち（先払いモード）
  PENDING_CLUB_CHECKOUT
  /// 先払い済み・本人エントリーで individual 分を相殺可能
  ACTIVE_WAIVER
  /// 締切後のクラブ請求に回す（本人は個人 Checkout をスキップ）
  DEFERRED_POST_CLOSE
  /// 先払い枠を消費済み
  CONSUMED
  CANCELLED
}

model ClubCompetitionPrepaidIndividualSlot {
  id                String                          @id @default(cuid())
  competitionId     String
  clubId            String
  coveredUserId     String
  status            ClubPrepaidIndividualSlotStatus @default(PENDING_CLUB_CHECKOUT)
  /// チームエントリー費の Payment.id（Checkout metadata と突合）
  clubPaymentId     String?
  consumedAt        DateTime?
  consumedByEntryId String?                         @unique

  competition     Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  club            Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  coveredUser     User              @relation("ClubPrepaidSlotCoveredUser", fields: [coveredUserId], references: [id], onDelete: Cascade)
  consumedByEntry CompetitionEntry? @relation("ClubPrepaidSlotConsumedEntry", fields: [consumedByEntryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competitionId, clubId, status])
  @@index([coveredUserId, competitionId])
}

model CompetitionEntry {
  id                      String                 @id @default(cuid())
  competitionId           String
  clubId                  String?
  userId                  String
  status                  CompetitionEntryStatus @default(SUBMITTED)
  totalFee                Int
  paymentId               String?
  /// クラブ一括（締切後請求含む）で個人参加費が清算された日時
  clubIndividualFeePaidAt DateTime?
  /// 誓約に同意した日時（エントリー送信日時と同一運用）
  pledgeAcceptedAt        DateTime?
  /// 同意時点の誓約文（Markdown）
  pledgeTextSnapshot      String?                @db.Text

  competition             Competition                           @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  club                    Club?                                 @relation(fields: [clubId], references: [id], onDelete: SetNull)
  user                    User                                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshot                EntrySnapshot?
  items                   EntryItem[]
  checkoutSessions        EntryCheckoutSession[]
  clubPrepaidSlotConsumed ClubCompetitionPrepaidIndividualSlot? @relation("ClubPrepaidSlotConsumedEntry")
  officialResultRows      OfficialResultRow[]
  participantStatuses     CompetitionParticipantStatus[]
  resultDraftRows         CompetitionResultDraftRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competitionId, userId])
}

model EntrySnapshot {
  id      String @id @default(cuid())
  entryId String @unique
  data    Json

  entry CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model EntryItem {
  id        String  @id @default(cuid())
  entryId   String
  eventId   String
  entryTime String?

  entry CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  event Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([entryId])
  @@index([eventId])
}

model TeamEntry {
  id            String @id @default(cuid())
  competitionId String
  eventId       String
  clubId        String
  teamName      String

  competition         Competition                    @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  event               Event                          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  club                Club                           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  members             TeamEntryMember[]
  officialResultRows  OfficialResultRow[]
  participantStatuses CompetitionParticipantStatus[]
  resultDraftRows     CompetitionResultDraftRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competitionId, eventId])
  @@index([clubId])
}

model TeamEntryMember {
  id          String  @id @default(cuid())
  teamEntryId String
  userId      String
  role        String?
  order       Int?

  teamEntry TeamEntry @relation(fields: [teamEntryId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamEntryId])
  @@index([userId])
}

model OfficialResult {
  id            String      @id @default(cuid())
  competitionId String
  eventId       String
  round         ResultRound @default(FINAL)

  publishedAt DateTime?
  lockedAt    DateTime?
  note        String?   @db.Text

  competition       Competition                   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  event             Event                         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rows              OfficialResultRow[]
  heatConfirmations OfficialResultHeatConfirmed[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitionId, eventId, round])
  @@index([competitionId, publishedAt])
}

/**
 * スタートリスト／当日運用でヒート単位にリザルト入力を確定した記録（暫定入力の締め）
 */
model OfficialResultHeatConfirmed {
  id                String   @id @default(cuid())
  officialResultId  String
  heat              Int
  confirmedAt       DateTime @default(now())
  confirmedByUserId String?

  officialResult OfficialResult @relation(fields: [officialResultId], references: [id], onDelete: Cascade)

  @@unique([officialResultId, heat])
  @@index([officialResultId])
}

model OfficialResultRow {
  id               String @id @default(cuid())
  officialResultId String

  entryType          ResultEntryType
  competitionEntryId String?
  teamEntryId        String?

  rank   Int?
  status ResultStatus @default(OK)
  /** 脱落式リザルト: 着順なしで次ラ進出（rank は null のまま） */
  advanceWithoutRank Boolean @default(false)

  resultValue Int?
  unit        ResultUnit @default(TIME_MS)
  resultText  String?

  penaltyValue Int?
  remarks      String? @db.Text

  lane     Int?
  heat     Int?
  tieGroup String?

  officialResult   OfficialResult    @relation(fields: [officialResultId], references: [id], onDelete: Cascade)
  competitionEntry CompetitionEntry? @relation(fields: [competitionEntryId], references: [id], onDelete: SetNull)
  teamEntry        TeamEntry?        @relation(fields: [teamEntryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([officialResultId, rank])
  @@index([officialResultId, heat, tieGroup])
  @@index([competitionEntryId])
  @@index([teamEntryId])
}

/**
 * 当日運用リザルト入力の生イベント（append-only）。公式結果本体とは分離して保持する
 */
model CompetitionHeatResultCaptureEvent {
