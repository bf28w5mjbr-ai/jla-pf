// This is your Prisma schema file
// Bluvium Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ========== CORE MODELS ==========

model User {
  id               String  @id @default(cuid())
  email            String  @unique
  emailVerified    Boolean @default(false)
  emailVerifyToken String?
  passwordHash     String? // SMS登録時はnull許可
  role             Role    @default(USER)
  primaryClubId    String?
  preferredLanguage String?
  mfaEnabled       Boolean @default(false)
  mfaEnforced      Boolean @default(false)
  nfcTagId         String?
  deletedAt        DateTime?
  deletionScheduledAt DateTime?

  // Profile fields
  familyName           String
  givenName            String
  familyNameKana       String // カタカナ（入力用）
  givenNameKana        String // カタカナ（入力用）
  normalizedFamilyName String // 正規化済み（検索用）
  normalizedGivenName  String // 正規化済み（検索用）
  dateOfBirth          DateTime // 生年月日
  sex                  Sex // 性別（必須）
  phoneNumber          String    @unique // E.164形式 +81... 必須
  phoneVerified        Boolean   @default(false)
  phoneVerifiedAt      DateTime?
  /// 最終ログイン（成功時更新・セキュリティ通知の判定に使用）
  lastLoginAt          DateTime?
  lastLoginIp          String?
  lastLoginUa          String?   @db.VarChar(512)
  profilePhotoUrl      String? // プロフィール写真URL

  // 住所情報
  postalCode   String // 郵便番号（ハイフンなし）
  prefecture   String // 都道府県
  city         String // 市区町村
  addressLine1 String // 町名・番地
  addressLine2 String? // 建物名・部屋番号（任意）

  // 緊急連絡先
  emergencyContactFamilyName     String? // 緊急連絡先姓
  emergencyContactGivenName      String? // 緊急連絡先名
  emergencyContactFamilyNameKana String? // 緊急連絡先姓（カナ）
  emergencyContactGivenNameKana  String? // 緊急連絡先名（カナ）
  emergencyContactPhone          String? // 緊急連絡先電話番号

  // JLA関連
  jlaMemberNumber       String? @unique // JLA会員番号
  legacyJlaMemberNumber String? @unique // 旧JLA会員番号

  // Relations
  memberships         Membership[]
  qualifications      Qualification[]
  clubsOwned          Club[]               @relation("ClubCreator")
  representativeClubs Club[]               @relation("ClubRepresentative")
  primaryClub         Club?                @relation("PrimaryClub", fields: [primaryClubId], references: [id])
  auditLogs           AuditLog[]
  clubAnnouncements   ClubAnnouncement[]
  clubActivityRecords ClubActivityRecord[]
  organizationsOwned  Organization[]       @relation("OrgCreator")
  representativeOrganizations Organization[] @relation("OrganizationRepresentative")
  orgAdminRoles       OrgAdmin[]
  associationAdminRoles AssociationAdmin[]
  notifications       Notification[]       // P2: 通知受信
  deviceTokens        DeviceToken[]
  expensesCreated     Expense[]            @relation("ExpenseCreator")
  expensesApproved    Expense[]            @relation("ExpenseApprover")
  expensesRejected    Expense[]            @relation("ExpenseRejector")
  expensesPaid        Expense[]            @relation("ExpensePayer")
  expenseAttachments  ExpenseAttachment[]  @relation("ExpenseAttachmentUploader")
  publicApiKeys       PublicApiKey[]
  clubTypeApplicationsRequested ClubTypeApplication[] @relation("ClubTypeApplicationRequester")
  clubTypeApplicationsApproved  ClubTypeApplication[] @relation("ClubTypeApplicationApprover")
  bankAccount        BankAccount?
  associationLicenses AssociationLicense[]
  notificationJobs   NotificationJob[]
  delegationsGiven   Delegation[] @relation("DelegationFrom")
  delegationsReceived Delegation[] @relation("DelegationTo")
  subscriptions      Subscription[]
  entryCheckoutSessions EntryCheckoutSession[]
  competitionEntries   CompetitionEntry[]
  teamEntryMembers     TeamEntryMember[]
  passkeyCredentials   PasskeyCredential[]
  passkeyChallenges    PasskeyChallenge[]
  recorderAssignments  CompetitionRecorderAssignment[] @relation("CompetitionRecorder")
  recorderAssignmentsGranted CompetitionRecorderAssignment[] @relation("CompetitionRecorderGrantor")
  dayCheckins          CompetitionDayCheckin[] @relation("CompetitionCheckinUser")
  dayCheckinsHandled   CompetitionDayCheckin[] @relation("CompetitionCheckinOperator")
  dayParticipantStatusesUpdated CompetitionParticipantStatus[] @relation("CompetitionParticipantStatusUpdater")
  teamMarshalParticipantStatuses CompetitionParticipantStatus[] @relation("TeamMarshalMember")
  resultDraftsUpdated  CompetitionResultDraft[] @relation("CompetitionResultDraftUpdater")
  startListSnapshotsCaptured CompetitionStartListSnapshot[] @relation("CompetitionStartListSnapshotCreator")
  competitionBalanceLinesCreated CompetitionBalanceLine[]
  officialApplications              CompetitionOfficialApplication[] @relation("OfficialApplicationApplicant")
  officialApplicationsReviewed      CompetitionOfficialApplication[] @relation("OfficialApplicationReviewer")
  csvExportRequestsRequested CompetitionEntryCsvExportRequest[] @relation("CompetitionEntryCsvExportRequester")
  csvExportRequestsReviewed  CompetitionEntryCsvExportRequest[] @relation("CompetitionEntryCsvExportReviewer")
  competitionTypeApplicationsRequested CompetitionTypeApplication[] @relation("CompetitionTypeApplicationRequester")
  competitionTypeApplicationsReviewed  CompetitionTypeApplication[] @relation("CompetitionTypeApplicationReviewer")
  officialAttendances            CompetitionOfficialAttendance[] @relation("CompetitionOfficialAttendanceUser")
  officialAttendanceRecords      CompetitionOfficialAttendance[] @relation("CompetitionOfficialAttendanceRecorder")
  technicalOfficialInvitesSent      CompetitionTechnicalOfficialInvitation[] @relation("TechnicalOfficialInviter")
  technicalOfficialInvitesReceived  CompetitionTechnicalOfficialInvitation[] @relation("TechnicalOfficialInvitee")
  technicalOfficialAssignments      CompetitionTechnicalOfficialAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 複合ユニーク制約: 同姓同名でも生年月日で区別
  @@unique([normalizedFamilyName, normalizedGivenName, dateOfBirth])
  @@index([dateOfBirth, normalizedFamilyName, normalizedGivenName])
  @@index([nfcTagId])
}

model PublicApiKey {
  id        String   @id @default(cuid())
  userId    String
  name      String
  key       String   @unique
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model BankAccount {
  id                String   @id @default(cuid())
  userId            String   @unique
  bankName          String
  branchName        String
  accountType       String
  accountNumber     String
  accountHolderName String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssociationLicense {
  id            String   @id @default(cuid())
  userId        String
  status        AssociationLicenseStatus @default(PENDING)
  licenseNumber String?
  issuedAt      DateTime?
  expiresAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

model QualificationCategory {
  id          String   @id @default(cuid())
  name        String
  description String? @db.Text

  templates QualificationTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QualificationTemplate {
  id                     String   @id @default(cuid())
  categoryId             String?
  kind                   String
  name                   String
  description            String? @db.Text
  requiresExpiry         Boolean @default(true)
  validityMonths         Int?
  domain                 String?
  level                  String?
  minAge                 Int?
  prerequisiteExpression String? @db.Text
  prerequisiteKinds      String[] @default([])
  nextKinds              String[] @default([])

  category QualificationCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  competitionsAsTechnicalOfficial Competition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([domain])
  @@index([level])
}

model NotificationTemplate {
  id            String                @id @default(cuid())
  type          String
  category      NotificationCategory  @default(GENERAL)
  titleTemplate String
  bodyTemplate  String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

model NotificationJob {
  id            String                 @id @default(cuid())
  status        NotificationJobStatus  @default(PENDING)
  createdById   String
  payload       Json?
  totalCount    Int?    @default(0)
  successCount  Int?    @default(0)
  failureCount  Int?    @default(0)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Delegation {
  id          String   @id @default(cuid())
  fromUserId  String
  toUserId    String
  status      DelegationStatus @default(ACTIVE)
  expiresAt   DateTime?

  fromUser User @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromUserId, status])
  @@index([toUserId, status])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  plan      String
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime @default(now())
  endsAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

model Club {
  id               String     @id @default(cuid())
  name             String
  nameKana         String?
  abbreviation     String? // 略称
  websiteUrl       String?
  status           ClubStatus @default(APPLYING)
  suspendedReason  String? // SUSPENDED/INACTIVE理由: "ANNUAL_FEE_UNPAID" | "NO_ADMIN" | "JLA_FREEZE" | "REJECTED"
  type             ClubType? // クラブ種別（JLAが付与、null=未確定）

  // 代表者情報
  representativeFamilyName     String?
  representativeGivenName      String?
  representativeFamilyNameKana String?
  representativeGivenNameKana  String?
  representativePostalCode     String?
  representativePrefecture     String?
  representativeCity           String?
  representativeAddressLine1   String?
  representativeAddressLine2   String?
  representativePhone          String?
  representativeUserId         String?

  // クラブ情報
  isLifesavingClub Boolean @default(false) // ライフセービングクラブ（監視場所は主にこの種のクラブ向け）
  patrolLocation   String? // 監視場所（ライフセービングクラブで利用）
  establishedYear  Int? // クラブ設立年

  // 事務局情報
  officePostalCode   String?
  officePrefecture   String?
  officeCity         String?
  officeAddressLine1 String?
  officeAddressLine2 String?
  officePhone        String?
  mailingName        String? // 郵便物の宛名

  logoUrl String?

  // Relations
  creatorId           String?
  creator             User?                    @relation("ClubCreator", fields: [creatorId], references: [id])
  representativeUser  User?                    @relation("ClubRepresentative", fields: [representativeUserId], references: [id])
  primaryUsers        User[]                   @relation("PrimaryClub")
  memberships         Membership[]
  announcements       ClubAnnouncement[]
  activityRecords     ClubActivityRecord[]
  annualRegistrations ClubAnnualRegistration[]
  typeApplications    ClubTypeApplication[]
  fiscalYears         ClubFiscalYear[]
  dues                ClubDues[]
  entryCheckoutSessions EntryCheckoutSession[]
  competitionEntries   CompetitionEntry[]
  teamEntries          TeamEntry[]
  technicalOfficialInvitations CompetitionTechnicalOfficialInvitation[]
  technicalOfficialAssignments CompetitionTechnicalOfficialAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
}

model Organization {
  id           String  @id @default(cuid())
  name         String // 団体名
  nameKana     String? // 団体名カナ
  abbreviation String? // 略称
  websiteUrl   String? // ウェブサイトURL
  email        String? // 代表メールアドレス
  phoneNumber  String? // 代表電話番号

  // 代表者情報
  representativeFamilyName     String?
  representativeGivenName      String?
  representativeFamilyNameKana String?
  representativeGivenNameKana  String?
  representativeUserId         String?

  // 事務局住所
  postalCode   String?
  prefecture   String?
  city         String?
  addressLine1 String?
  addressLine2 String?

  // 詳細情報
  description     String? @db.Text // 団体説明
  establishedYear Int? // 設立年
  logoUrl         String? // ロゴURL

  // 登録料（オンボーディング）
  onboardingFeeStatus  OnboardingFeeStatus @default(NOT_PAID)
  onboardingFeePaidAt  DateTime?

  /// Stripe Connect（エントリー代の送金先）
  stripeConnectAccountId        String?
  stripeConnectChargesEnabled   Boolean @default(false)
  /// PF 年額課金用 Stripe Customer（プラットフォーム側）
  stripeCustomerId              String?
  organizerSubscriptionId       String?
  organizerSubscriptionStatus   OrganizerSubscriptionStatus @default(NONE)
  organizerSubscriptionCurrentPeriodEnd DateTime?

  // ステータス
  status OrgStatus @default(PENDING)

  // Relations
  createdById  String?
  createdBy    User?         @relation("OrgCreator", fields: [createdById], references: [id])
  representativeUser User?   @relation("OrganizationRepresentative", fields: [representativeUserId], references: [id])
  admins       OrgAdmin[]
  competitions Competition[] // 団体が主催する大会

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Association {
  id           String @id @default(cuid())
  name         String // DB migration enforces case-insensitive uniqueness on lower(name)
  abbreviation String? // DB migration enforces case-insensitive uniqueness on lower(abbreviation)
  status       AssociationStatus @default(PENDING)

  admins AssociationAdmin[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssociationAdmin {
  id            String               @id @default(cuid())
  userId        String
  associationId String
  role          AssociationAdminRole @default(ADMIN)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, associationId])
}

model OrgAdmin {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           OrgAdminRole @default(ADMIN)

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Membership {
  id     String           @id @default(cuid())
  userId String
  clubId String
  role   MembershipRole   @default(MEMBER)
  status MembershipStatus @default(PENDING)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  dues ClubDues[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, clubId])
  @@index([clubId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model Qualification {
  id            String              @id @default(cuid())
  userId        String
  kind          String // e.g., "BLS", "ILS", etc.
  certNumber    String?
  issueDate     DateTime?
  expiryDate    DateTime?
  status        QualificationStatus @default(PENDING)
  attachmentUrl String?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Asc)])
  @@index([status, expiryDate])
}

model RegistrationSession {
  id String @id @default(cuid())

  // 仮登録情報
  phoneNumber                    String // E.164形式 +81...
  familyName                     String
  givenName                      String
  familyNameKana                 String
  givenNameKana                  String
  dateOfBirth                    DateTime
  sex                            Sex // 性別
  postalCode                     String
  prefecture                     String
  city                           String
  addressLine1                   String
  addressLine2                   String?
  emergencyContactFamilyName     String?
  emergencyContactGivenName      String?
  emergencyContactFamilyNameKana String?
  emergencyContactGivenNameKana  String?
  emergencyContactPhone          String?
  email                          String?
  password                       String? // パスワード（bcryptハッシュ化済み、任意）

  // OTP情報
  otpHash      String // bcryptハッシュ
  otpAttempts  Int      @default(0) // 失敗回数
  otpExpiresAt DateTime // OTP有効期限（5分）
  /// SMS / メールのどちらで OTP を届けたか（EMAIL 時は登録完了時に電話未検証扱い）
  registrationOtpDelivery String?

  // 再送制限
  lastSentAt    DateTime @default(now())
  sendCount     Int      @default(1) // 送信回数
  hourlyResetAt DateTime // 1時間制限のリセット時刻

  // セッション有効期限
  expiresAt DateTime // 30分後

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phoneNumber])
  @@index([expiresAt])
}

model PasskeyCredential {
  id           String   @id @default(cuid())
  userId       String
  credentialId Bytes    @unique
  publicKey    Bytes
  counter      Int      @default(0)
  transports   Json?
  label        String   @default("パスキー")
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PasskeyChallenge {
  id        String   @id @default(cuid())
  userId    String
  challenge String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

// SMS OTPログイン用の一時セッション
/// ログイン試行・SMS送信などのレート制限（キー例: pwd:ip:…, pwd:email:sha256, smsstart:ip:…）
model LoginThrottleBucket {
  id          String   @id @default(cuid())
  key         String   @unique
  failCount   Int      @default(0)
  windowStart DateTime

  @@index([windowStart])
}

model LoginSession {
  id String @id @default(cuid())

  phoneNumber String @unique // E.164形式 +81...

  // OTP情報
  otpHash      String // bcryptハッシュ
  otpAttempts  Int      @default(0) // 失敗回数
  otpExpiresAt DateTime // OTP有効期限（5分）

  // 再送制限
  lastSentAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phoneNumber])
  @@index([otpExpiresAt])
}

model AuditLog {
  id          String  @id @default(cuid())
  actorUserId String
  action      String
  target      String?
  meta        Json?

  // Relations
  user User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([actorUserId, action, createdAt])
}

// P2: アプリ内通知（即時・ユーザー制限不可）
model Notification {
  id       String             @id @default(cuid())
  userId   String             // 受信者
  category NotificationCategory @default(GENERAL)
  type     String             // 通知種別（例: "CLUB_APPLICATION", "CLUB_APPROVED"）
  title    String             // 通知タイトル
  body     String             @db.Text // 通知本文
  read     Boolean            @default(false) // 既読フラグ
  relatedId String?           // 関連ID（clubId, membershipId等）
  linkUrl  String?            // リンク先URL
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@index([userId, read])
  @@index([userId, createdAt])
}

model DeviceToken {
  id       String @id @default(cuid())
  userId   String
  token    String @unique
  platform String // ios | android | web
  active   Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
}

model ClubAnnouncement {
  id       String  @id @default(cuid())
  clubId   String
  authorId String
  title    String
  content  String  @db.Text
  isPinned Boolean @default(false)

  // Relations
  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId, createdAt])
  @@index([clubId, isPinned])
}

model ClubActivityRecord {
  id           String   @id @default(cuid())
  clubId       String
  authorId     String
  activityType String // 例: "大会", "練習", "監視活動", "イベント"
  title        String
  description  String?  @db.Text
  activityDate DateTime
  location     String?
  participants Int? // 参加人数
  achievements String?  @db.Text // 成績・実績

  // Relations
  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId, activityDate])
  @@index([clubId, activityType])
}

model ClubAnnualRegistration {
  id                    String                       @id @default(cuid())
  clubId                String
  fiscalYear            Int // 年度（例: 2026）
  clubType              ClubType? // 登録時のクラブ種別スナップショット
  registrationFee       Int // 登録料（円）
  memberCount           Int // 登録時の会員数
  status                ClubAnnualRegistrationStatus @default(PENDING)
  stripePaymentIntentId String? // Stripe PaymentIntent ID
  paidAt                DateTime? // 支払い完了日時
  expiresAt             DateTime? // 有効期限

  // Relations
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, fiscalYear])
  @@index([clubId, fiscalYear])
  @@index([status])
}

model ClubTypeApplication {
  id              String                    @id @default(cuid())
  clubId          String
  requestedType   ClubType
  status          ClubTypeApplicationStatus @default(PENDING)
  kind            ClubTypeApplicationKind   @default(INITIAL)
  targetFiscalYear Int?
  requestedById   String
  approvedById    String?
  rejectionReason String?
  approvedAt      DateTime?

  club        Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  requestedBy User @relation("ClubTypeApplicationRequester", fields: [requestedById], references: [id])
  approvedBy  User? @relation("ClubTypeApplicationApprover", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId, status])
  @@index([requestedById])
}

model ClubFiscalYear {
  id                     String             @id @default(cuid())
  clubId                 String
  fiscalYear             Int
  startDate              DateTime
  endDate                DateTime
  membershipFee          Int                @default(0)
  membershipFeeAppliesTo ClubDuesAppliesTo  @default(ALL_MEMBERS)
  description            String?            @db.Text

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  dues ClubDues[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, fiscalYear])
  @@index([clubId, startDate, endDate])
}

model ClubDues {
  id           String          @id @default(cuid())
  clubId       String
  fiscalYearId String
  memberId     String
  amount       Int
  status       ClubDuesStatus  @default(UNPAID)
  dueDate      DateTime?
  paidDate     DateTime?
  invoiceNumber String?
  invoiceIssuedAt DateTime?
  invoiceUrl   String?
  receiptNumber String?
  receiptUrl   String?
  notes        String?         @db.Text

  club       Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  fiscalYear ClubFiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  member     Membership     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, fiscalYearId, memberId])
  @@index([clubId, status])
  @@index([clubId, fiscalYearId, status])
  @@index([memberId])
}

model Expense {
  id             String          @id @default(cuid())
  ownerType      ExpenseOwnerType
  ownerId        String

  amount       Int
  taxRate      Int?
  taxAmount    Int?
  totalAmount  Int

  category     ExpenseCategory
  description  String?
  status       ExpenseStatus     @default(DRAFT)

  submittedAt    DateTime?
  approvedAt     DateTime?
  approvedById   String?
  rejectedAt     DateTime?
  rejectedById   String?
  rejectedReason String?
  paidAt         DateTime?
  paidById       String?

  createdById  String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  attachments  ExpenseAttachment[]

  createdBy    User              @relation("ExpenseCreator", fields: [createdById], references: [id])
  approvedBy   User?             @relation("ExpenseApprover", fields: [approvedById], references: [id])
  rejectedBy   User?             @relation("ExpenseRejector", fields: [rejectedById], references: [id])
  paidBy       User?             @relation("ExpensePayer", fields: [paidById], references: [id])

  @@index([ownerType, ownerId])
  @@index([status])
  @@index([createdById])
}

model ExpenseAttachment {
  id            String   @id @default(cuid())
  expenseId     String
  url           String
  filename      String?
  mimeType      String?
  size          Int?
  uploadedById  String
  createdAt     DateTime @default(now())

  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  uploadedBy  User    @relation("ExpenseAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([expenseId])
}

model Budget {
  id         String          @id @default(cuid())
  ownerType  ExpenseOwnerType
  ownerId    String
  fiscalYear Int
  limit      Int
  used       Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([ownerType, ownerId, fiscalYear])
}

model Payment {
  id                      String        @id @default(cuid())
  type                    PaymentType
  ownerType               PaymentOwnerType
  ownerId                 String
  userId                  String
  status                  PaymentStatus @default(PENDING)
  amount                  Int
  currency                String        @default("jpy")
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?
  metadata                Json?
  paidAt                  DateTime?
  expiresAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerType, ownerId, type])
  @@index([status])
  @@index([userId])
}

model StripeEvent {
  id        String            @id @default(cuid())
  eventId   String            @unique
  type      String
  accountId String?
  livemode  Boolean
  data      Json
  status    StripeEventStatus @default(RECEIVED)
  errorMessage String?

  receivedAt  DateTime @default(now())
  processedAt DateTime?

  @@index([type])
  @@index([status])
}

model EntryCheckoutSession {
  id                      String                     @id @default(cuid())
  competitionId           String
  clubId                  String
  userId                  String
  status                  EntryCheckoutSessionStatus @default(PENDING)
  amount                  Int
  currency                String                     @default("jpy")
  stripeCheckoutSessionId String?                    @unique
  /// Stripe Charge.receipt_url（カード決済のホスト領収書）
  stripeReceiptUrl        String?
  payload                 Json?
  completedAt             DateTime?
  expiredAt               DateTime?
  entryId                 String?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  club        Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry       CompetitionEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competitionId, userId])
}

model CompetitionEntry {
  id            String                 @id @default(cuid())
  competitionId String
  clubId        String?
  userId        String
  status        CompetitionEntryStatus @default(SUBMITTED)
  totalFee      Int
  paymentId     String?
  /// 誓約に同意した日時（エントリー送信日時と同一運用）
  pledgeAcceptedAt   DateTime?
  /// 同意時点の誓約文（Markdown）
  pledgeTextSnapshot String? @db.Text

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  club        Club?       @relation(fields: [clubId], references: [id], onDelete: SetNull)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshot    EntrySnapshot?
  items       EntryItem[]
  checkoutSessions EntryCheckoutSession[]
  officialResultRows OfficialResultRow[]
  participantStatuses CompetitionParticipantStatus[]
  resultDraftRows     CompetitionResultDraftRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competitionId, userId])
}

model EntrySnapshot {
  id      String @id @default(cuid())
  entryId String @unique
  data    Json

  entry CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model EntryItem {
  id        String @id @default(cuid())
  entryId   String
  eventId   String
  entryTime String?

  entry CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([entryId])
  @@index([eventId])
}

model TeamEntry {
  id            String   @id @default(cuid())
  competitionId String
  eventId       String
  clubId        String
  teamName      String

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  club        Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  members     TeamEntryMember[]
  officialResultRows OfficialResultRow[]
  participantStatuses CompetitionParticipantStatus[]
  resultDraftRows     CompetitionResultDraftRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competitionId, eventId])
  @@index([clubId])
}

model TeamEntryMember {
  id        String @id @default(cuid())
  teamEntryId String
  userId    String
  role      String?
  order     Int?

  teamEntry TeamEntry @relation(fields: [teamEntryId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamEntryId])
  @@index([userId])
}

model OfficialResult {
  id            String      @id @default(cuid())
  competitionId String
  eventId       String
  round         ResultRound @default(FINAL)

  publishedAt   DateTime?
  lockedAt      DateTime?
  note          String?     @db.Text

  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rows               OfficialResultRow[]
  heatConfirmations  OfficialResultHeatConfirmed[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([competitionId, eventId, round])
  @@index([competitionId, publishedAt])
}

/** スタートリスト／当日運用でヒート単位にリザルト入力を確定した記録（暫定入力の締め） */
model OfficialResultHeatConfirmed {
  id                String   @id @default(cuid())
  officialResultId  String
  heat              Int
  confirmedAt       DateTime @default(now())
  confirmedByUserId String?

  officialResult OfficialResult @relation(fields: [officialResultId], references: [id], onDelete: Cascade)

  @@unique([officialResultId, heat])
  @@index([officialResultId])
}

model OfficialResultRow {
  id                String          @id @default(cuid())
  officialResultId  String

  entryType         ResultEntryType
  competitionEntryId String?
  teamEntryId       String?

  rank              Int?
  status            ResultStatus    @default(OK)

  resultValue       Int?
  unit              ResultUnit      @default(TIME_MS)
  resultText        String?

  penaltyValue      Int?
  remarks           String?         @db.Text

  lane              Int?
  heat              Int?
  tieGroup          String?

  officialResult    OfficialResult  @relation(fields: [officialResultId], references: [id], onDelete: Cascade)
  competitionEntry CompetitionEntry? @relation(fields: [competitionEntryId], references: [id], onDelete: SetNull)
  teamEntry         TeamEntry?       @relation(fields: [teamEntryId], references: [id], onDelete: SetNull)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([officialResultId, rank])
  @@index([officialResultId, heat, tieGroup])
  @@index([competitionEntryId])
  @@index([teamEntryId])
}

/** 当日運用リザルト入力の生イベント（append-only）。公式結果本体とは分離して保持する */
model CompetitionHeatResultCaptureEvent {
  id                 String                   @id
  competitionId      String
  eventId            String
  round              ResultRound
  heatIndex          Int
  lane               Int?
  rank               Int?
  tieGroup           String?
  source             ResultCaptureEventSource
  eventType          ResultCaptureEventType   @default(APPEND)
  participantType    CompetitionParticipantType
  competitionEntryId String?
  teamEntryId        String?
  capturedByUserId   String?
  errorCode          String?
  errorMessage       String?                  @db.Text
  createdAt          DateTime                 @default(now())

  @@index([competitionId, eventId, round, heatIndex, createdAt])
  @@index([competitionId, createdAt])
}

model CompetitionRecorderAssignment {
  id               String   @id @default(cuid())
  competitionId    String
  userId           String
  assignedByUserId String
  isActive         Boolean  @default(true)

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation("CompetitionRecorder", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy  User        @relation("CompetitionRecorderGrantor", fields: [assignedByUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitionId, userId])
  @@index([competitionId, isActive])
}

model CompetitionDayCheckin {
  id               String           @id @default(cuid())
  competitionId    String
  userId           String
  eventDate        DateTime
  method           DayCheckinMethod
  nfcTagId         String?
  checkedInAt      DateTime         @default(now())
  checkedInByUserId String?
  note             String?          @db.Text

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation("CompetitionCheckinUser", fields: [userId], references: [id], onDelete: Cascade)
  checkedInBy User?       @relation("CompetitionCheckinOperator", fields: [checkedInByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitionId, userId, eventDate])
  @@index([competitionId, eventDate])
}

model CompetitionParticipantStatus {
  id                String                    @id @default(cuid())
  competitionId     String
  eventId           String
  participantType   CompetitionParticipantType
  competitionEntryId String?
  teamEntryId       String?
  /** チーム種目: 構成員（ユーザー）単位のマーシャル。TEAM 行で必須（個人種目は null） */
  teamMemberUserId  String?
  /** マーシャル・召集状態のスコープ。前ラの CALLED が次ラに引きずられないようにする */
  marshalRound      ResultRound               @default(HEAT)
  status            DayOpsParticipantStatus   @default(PENDING)
  reason            String?                   @db.Text
  calledAt          DateTime?
  updatedByUserId   String?

  competition Competition      @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  competitionEntry CompetitionEntry? @relation(fields: [competitionEntryId], references: [id], onDelete: SetNull)
  teamEntry   TeamEntry?       @relation(fields: [teamEntryId], references: [id], onDelete: SetNull)
  teamMemberUser User?         @relation("TeamMarshalMember", fields: [teamMemberUserId], references: [id], onDelete: SetNull)
  updatedBy   User?            @relation("CompetitionParticipantStatusUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitionId, eventId, participantType, competitionEntryId, teamEntryId, teamMemberUserId, marshalRound])
  @@index([competitionId, eventId, status])
  @@index([competitionId, eventId, marshalRound])
  @@index([competitionEntryId])
  @@index([teamEntryId])
  @@index([teamMemberUserId])
}

model CompetitionResultDraft {
  id                String             @id @default(cuid())
  competitionId     String
  eventId           String
  round             ResultRound        @default(FINAL)
  status            DraftResultStatus  @default(PROVISIONAL)
  note              String?            @db.Text
  publishedAt       DateTime?
  finalizedAt       DateTime?
  lastUpdatedByUserId String?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rows        CompetitionResultDraftRow[]
  lastUpdatedBy User?     @relation("CompetitionResultDraftUpdater", fields: [lastUpdatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitionId, eventId, round])
  @@index([competitionId, eventId, status])
}

model CompetitionResultDraftRow {
  id                 String          @id @default(cuid())
  draftId            String
  entryType          ResultEntryType
  competitionEntryId String?
  teamEntryId        String?
  rank               Int?
  status             ResultStatus    @default(OK)
  resultValue        Int?
  unit               ResultUnit      @default(TIME_MS)
  resultText         String?
  penaltyValue       Int?
  remarks            String?         @db.Text
  lane               Int?
  heat               Int?

  draft            CompetitionResultDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  competitionEntry CompetitionEntry? @relation(fields: [competitionEntryId], references: [id], onDelete: SetNull)
  teamEntry        TeamEntry?        @relation(fields: [teamEntryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([draftId, rank])
  @@index([competitionEntryId])
  @@index([teamEntryId])
}

model CompetitionStartListSnapshot {
  id              String  @id @default(cuid())
  competitionId   String  @unique
  data            Json
  createdByUserId String?
  capturedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("CompetitionStartListSnapshotCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
}

model Competition {
  id             String @id @default(cuid())
  organizationId String // 主催団体ID

  /// 大会作成時点の主催団体表示名（開催者プロフィールの名称変更と独立）
  hostOrganizationName          String?
  hostOrganizationNameKana      String?
  hostOrganizationAbbreviation  String?

  // 基本情報
  name        String // 大会名
  nameKana    String? // 大会名カナ
  description String? @db.Text // 大会説明
  category    String? // カテゴリ（例: "プール", "オープンウォーター", "ジュニア"）
  /// 大会種別（PF承認で大会単位に付与）
  competitionType CompetitionType?

  // 開催情報
  startDate    DateTime // 開催開始日時
  endDate      DateTime // 開催終了日時
  venue        String // 開催場所
  venueAddress String? // 会場住所

  // 参加情報
  entryStartDate  DateTime? // エントリー開始日時
  entryEndDate    DateTime? // エントリー終了日時
  maxParticipants Int? // 最大参加者数
  entryFee        Json? // 参加費設定（JSON: {individualEntryFee, teamEntryFeePerTeam}）
  requiredQualifications Json? // 出場に必要な資格（文字列配列）
  participantEligibilityText String? @db.Text // 参加対象者（自由記述）
  allowMultipleEventEntries Boolean @default(true) // 種目の複数選択を許可
  maxEventEntriesPerPerson Int? // 1人あたりのエントリー可能種目数上限（null = 無制限）
  requireClubMembership Boolean @default(false) // 所属クラブ必須
  startListSettings Json? // スタートリスト設定（JSON: {heatCount: number, heatSize: number, updatedAt?: string}）
  minAge          Int? // 参加可能な最小年齢
  maxAge          Int? // 参加可能な最大年齢

  /// エントリー時の誓約（公開時に未使用だった大会は後から有効化不可）
  entryPledgeEnabled     Boolean @default(false)
  entryPledgeText        String? @db.Text
  entryPledgeLockNoOffer Boolean @default(false)

  /// 当日運用（マーシャル・リザルト等）用アクセス暗号の bcrypt ハッシュ。未設定時は主催管理者のみ
  dayOpsAccessSecretHash String?

  // クラブ種別制限
  allowedClubTypes ClubType[] // エントリー可能なクラブ種別（空配列 = 全種別可）

  // オフィシャル募集設定
  officialRecruitmentEnabled Boolean @default(true) // オフィシャル募集の公開可否（公開ページの導線表示）
  officialPositions Json? // オフィシャルポジション設定（JSON: [{positionName: string, count: number}]）
  officialQualificationFilterEnabled Boolean @default(false) // true: 資格要件を満たす応募者のみ許可

  // テクニカルオフィシャル機能の有効化設定
  technicalOfficialRecruitmentEnabled Boolean @default(true) // true: この大会でTO機能を使用する
  /// テクニカルオフィシャルに必要な資格テンプレート（大会ごとに主催が選択）
  technicalOfficialQualificationTemplateId String?
  technicalOfficialQualificationTemplate     QualificationTemplate? @relation(fields: [technicalOfficialQualificationTemplateId], references: [id], onDelete: SetNull)
  /// [{ minEntries: number, requiredCount: number }] 昇順で保存。閾値の件数＝クラブの個人エントリー件数（キャンセル除く）。チームエントリー件数は含めない
  technicalOfficialTiers                   Json?

  // 関係組織情報
  sponsors         String? @db.Text // 後援（複数の場合は改行区切り）
  cooperators      String? @db.Text // 協賛（複数の場合は改行区切り）
  cooperatorsLogos Json? // 協賛ロゴ [{name: string, logoUrl: string}]
  supporters       String? @db.Text // 協力（複数の場合は改行区切り）
  grants           String? @db.Text // 助成（複数の場合は改行区切り）
  grantsLogos      Json? // 助成ロゴ [{name: string, logoUrl: string}]

  // 公開設定
  status      CompetitionStatus @default(DRAFT)
  isPublished Boolean           @default(false)
  publishedAt DateTime?

  // Relations
  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  announcements CompetitionAnnouncement[]
  attachments   CompetitionAttachment[]
  galleryPhotos CompetitionGalleryPhoto[]
  events        Event[] // 大会種目
  ageCategories CompetitionAgeCategory[]
  entries       CompetitionEntry[]
  entryCheckoutSessions EntryCheckoutSession[]
  teamEntries   TeamEntry[]
  officialResults OfficialResult[]
  recorderAssignments CompetitionRecorderAssignment[]
  dayCheckins         CompetitionDayCheckin[]
  participantStatuses CompetitionParticipantStatus[]
  heatMarshalStates   CompetitionHeatMarshalState[]
  resultDrafts        CompetitionResultDraft[]
  startListSnapshot   CompetitionStartListSnapshot?
  balanceLines        CompetitionBalanceLine[]
  officialApplications CompetitionOfficialApplication[]
  officialAttendances   CompetitionOfficialAttendance[]
  entryCsvExportRequests CompetitionEntryCsvExportRequest[]
  technicalOfficialInvitations CompetitionTechnicalOfficialInvitation[]
  technicalOfficialAssignments CompetitionTechnicalOfficialAssignment[]
  typeApplications             CompetitionTypeApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, startDate])
  @@index([status, isPublished])
  @@index([entryEndDate])
}

/// 大会主催者からPFへ行う「大会種別（1種/2種）」申請
model CompetitionTypeApplication {
  id                 String                           @id @default(cuid())
  competitionId      String
  requestedType      CompetitionType
  status             CompetitionTypeApplicationStatus @default(PENDING)
  requestedByUserId  String
  reviewedByUserId   String?
  rejectionReason    String?                          @db.Text
  reviewedAt         DateTime?
  approvedAt         DateTime?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  requestedBy User        @relation("CompetitionTypeApplicationRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation("CompetitionTypeApplicationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competitionId, status])
  @@index([status, createdAt])
}

/// クラブからテクニカルオフィシャルへ送る依頼（メンバー指定 or SMS）
model CompetitionTechnicalOfficialInvitation {
  id                String                             @id @default(cuid())
  token             String                             @unique
  competitionId     String
  clubId            String
  invitedByUserId   String
  invitedUserId     String?
  invitePhoneE164   String?
  status            TechnicalOfficialInvitationStatus @default(PENDING)

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  club        Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  invitedBy   User        @relation("TechnicalOfficialInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  invitedUser User?       @relation("TechnicalOfficialInvitee", fields: [invitedUserId], references: [id], onDelete: SetNull)
  assignment  CompetitionTechnicalOfficialAssignment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competitionId, clubId, status])
  @@index([invitedUserId, status])
}

/// 承認済みのテクニカルオフィシャル任命（クラブ×大会×ユーザーで一意）
model CompetitionTechnicalOfficialAssignment {
  id             String   @id @default(cuid())
  competitionId  String
  clubId         String
  userId         String
  invitationId   String?  @unique

  competition Competition                        @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  club        Club                               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user        User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation  CompetitionTechnicalOfficialInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitionId, clubId, userId])
  @@index([competitionId, clubId])
}

enum TechnicalOfficialInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// エントリー一覧CSV出力の依頼（PF承認後にダウンロード可能）
model CompetitionEntryCsvExportRequest {
  id                String   @id @default(cuid())
  competitionId     String
  /// INDIVIDUAL | TEAM
  scope             String
  requestedByUserId String
  /// PENDING | APPROVED | REJECTED
  status            String
  reviewedByUserId  String?
  reviewedAt        DateTime?
  /// 承認後、CSVダウンロード可能な期限
  expiresAt         DateTime?
  rejectReason      String?  @db.Text

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  requestedBy User        @relation("CompetitionEntryCsvExportRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation("CompetitionEntryCsvExportReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competitionId, status])
  @@index([status, createdAt])
}

/// 大会オフィシャル（スタッフ等）の応募
model CompetitionOfficialApplication {
  id                 String                    @id @default(cuid())
  competitionId      String
  userId             String
  positionName       String
  message            String?                   @db.Text
  status             OfficialApplicationStatus @default(PENDING)
  reviewedAt         DateTime?
  reviewedByUserId   String?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation("OfficialApplicationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation("OfficialApplicationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitionId, userId])
  @@index([competitionId, status])
}

/// 大会オフィシャルの当日出席記録（日付単位）
model CompetitionOfficialAttendance {
  id               String                   @id @default(cuid())
  competitionId    String
  userId           String
  attendanceDate   DateTime                 @db.Date
  method           OfficialAttendanceMethod @default(MANUAL)
  recordedByUserId String?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation("CompetitionOfficialAttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  recordedBy  User?       @relation("CompetitionOfficialAttendanceRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitionId, userId, attendanceDate])
  @@index([competitionId, attendanceDate])
  @@index([userId, attendanceDate])
}

/// 大会の簡易バランスシート用（手動仕訳：日付・科目・収入/支出・金額・備考）
model CompetitionBalanceLine {
  id             String   @id @default(cuid())
  competitionId  String
  /// 取引日（日付のみ）
  lineDate       DateTime @db.Date
  /// 科目（自由記述）
  accountSubject String
  kind           CompetitionBalanceLineKind
  /// 円・正の整数
  amount         Int
  notes          String?  @db.Text

  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competitionId, lineDate])
}

model CompetitionAnnouncement {
  id            String    @id @default(cuid())
  competitionId String
  title         String // お知らせタイトル
  content       String    @db.Text // お知らせ内容
  publishedAt   DateTime? // 公開日時（nullの場合は下書き）

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competitionId, createdAt])
}

model CompetitionAttachment {
  id            String @id @default(cuid())
  competitionId String
  fileName      String // ファイル名
  fileUrl       String // ファイルURL
  fileSize      Int // ファイルサイズ（バイト）
  mimeType      String // MIMEタイプ

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([competitionId, createdAt])
}

/// 大会公開ページに表示するフォトギャラリー
model CompetitionGalleryPhoto {
  id            String @id @default(cuid())
  competitionId String
  imageUrl      String
  fileName      String?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([competitionId, createdAt])
}

/// 種目の年齢カテゴリ（生年月日の許容範囲）。種目は任意で1カテゴリに紐づけ、紐づいた場合は範囲が種目に同期される
model CompetitionAgeCategory {
  id             String   @id @default(cuid())
  competitionId  String
  name           String
  displayOrder   Int      @default(0)
  eligibleBirthDateFrom DateTime? @db.Date
  eligibleBirthDateTo   DateTime? @db.Date

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  events      Event[]

  @@index([competitionId, displayOrder])
}

model Event {
  id                String        @id @default(cuid())
  competitionId     String
  /// 年齢カテゴリに連動する場合。手動で生年月日範囲を変えると解除される
  ageCategoryId     String?
  name              String // 種目名（例: "100m障害物"）
  sex               Sex // 性別（MALE: 男子, FEMALE: 女子）
  type              EventType     @default(INDIVIDUAL) // 種目タイプ（個人/チーム）
  category          EventCategory @default(POOL) // 競技カテゴリ（プール/オーシャン）
  requiresEntryTime Boolean       @default(true) // エントリータイム入力必須
  displayOrder      Int           @default(0) // 表示順序
  minAge            Int? // 種目の最小年齢（満年齢・eligible が未設定のときのみ使用）
  maxAge            Int? // 種目の最大年齢（満年齢・eligible が未設定のときのみ使用）
  /// 参加可能な生年月日の下限（この日に生まれた人を含む。日本暦日で解釈）
  eligibleBirthDateFrom DateTime? @db.Date
  /// 参加可能な生年月日の上限（この日に生まれた人を含む）
  eligibleBirthDateTo   DateTime? @db.Date
  /// 種目の想定開始日時（進行・表示用）
  scheduledStartAt  DateTime?
  /// 種目の想定終了日時（任意）
  scheduledEndAt    DateTime?
  /// 1レースあたりの最大レーン数（全ラウンド共通・プール／オーシャン共通、null は未設定）
  preliminaryHeatLaneCount Int?
  /// スタートリストのラウンド数（初回レースを含む全タブ数。1〜32）
  startListRoundCount      Int      @default(1)
  /// スタートリスト「ステップ1」（ラウンド別ヒート数）確定日時。未確定の間は当日マーシャル操作不可
  startListHeatPlanConfirmedAt DateTime?
  /// マーシャル（召集・状態更新等）開始日時。設定後はラウンド別ヒート分割を変更不可
  marshalStartedAt         DateTime?
  /// チーム種目のみ: リレー等のポジション数（1〜32）。個人種目では常に null
  teamRelayPositionCount   Int?
  /// チーム種目のみ: ポジション名（先頭が第1ポジション）。JSON 文字列配列
  teamRelayPositionNames   Json?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  ageCategory CompetitionAgeCategory? @relation(fields: [ageCategoryId], references: [id], onDelete: Restrict)
  entryItems  EntryItem[]
  teamEntries TeamEntry[]
  officialResults OfficialResult[]
  participantStatuses CompetitionParticipantStatus[]
  heatMarshalStates   CompetitionHeatMarshalState[]
  resultDrafts        CompetitionResultDraft[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competitionId, displayOrder])
  @@index([ageCategoryId])
}

/// 当日運用: ラウンド・ヒート単位の召集締切（スタートリストスナップショットの heatIndex と対応）
model CompetitionHeatMarshalState {
  id             String       @id @default(cuid())
  competitionId  String
  eventId        String
  round          ResultRound
  heatIndex      Int
  callClosedAt   DateTime?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitionId, eventId, round, heatIndex])
  @@index([eventId, round])
}

enum EventType {
  INDIVIDUAL // 個人種目
  TEAM // チーム種目
}

enum EventCategory {
  POOL // プール競技
  OCEAN // オーシャン競技
}

